<launch>

  <!-- Namespace must match rto_bringup (must match rto_node namespace) -->
  <arg name="ns" default="rto3" description="Namespace matching rto_bringup (must match rto_node namespace)"/>

  <node pkg="teleop_twist_keyboard" exec="teleop_twist_keyboard" name="teleop_twist_keyboard" output="screen">
    <remap from="/cmd_vel" to="/$(var ns)/cmd_vel"/>
  </node>

</launch>
