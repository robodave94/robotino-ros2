<?xml version="1.0"?>
<!-- Robotino 4 macro definition. -->
<!-- -->
<!-- This file contains the robotino4 xacro macro only. It does NOT instantiate -->
<!-- the macro so it can be safely included by composition xacros that need to -->
<!-- instantiate multiple robots (each with its own prefix). Consumers who want -->
<!-- a runnable standalone URDF should use base.urdf.xacro instead, which wraps -->
<!-- this macro and invokes it with a single prefix arg. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:include filename="$(find rto4_description)/urdf/util/common_properties.xacro" />

  <!-- ************************** Robotino4 Macro ***************************** -->
  <xacro:macro name="robotino4" params="prefix:=''">
    <xacro:property name="frame_ns" value="${prefix + '/' if prefix != '' else ''}" />

  <!-- *************************** Base Footprint ***************************** -->
  <link name="${frame_ns}base_footprint">
  </link>
  <!-- ************************************************************************ -->

  <!-- ****************************** Main Body ******************************* -->
  <link name="${frame_ns}base_link">

    <visual>
      <origin xyz="0 0 0.035" rpy="0 0 ${pi / 2}"/>
      <geometry>
        <mesh filename="package://rto4_description/meshes/rover/rto4_body.dae" scale="0.01 0.01 0.01"/>
      </geometry>
    </visual>

    <collision>
      <origin xyz="0 0 0.035" rpy="0 0 ${pi / 2}"/>
      <geometry>
        <mesh filename="package://rto4_description/meshes/rover/rto4_body.dae" scale="0.01 0.01 0.01"/>
      </geometry>
    </collision>

    <inertial>
      <mass value="20"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
  </link>

  <!-- ========= Main Body - Joint ========= -->
  <joint name="${frame_ns}base_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="${frame_ns}base_footprint"/>
    <child link="${frame_ns}base_link"/>
  </joint>
  <!-- ************************************************************************ -->

  <!-- ***************************** Wheel Macro ****************************** -->
  <xacro:macro name="wheel_link" params="prefix_ns number">

    <link name="${prefix_ns}wheel${number}_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rto4_description/meshes/rover/rto4_wheel.dae" scale="0.01 0.01 0.01"/>
        </geometry>
      </visual>

      <collision>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://rto4_description/meshes/rover/rto4_wheel.dae" scale="0.01 0.01 0.01"/>
        </geometry>
      </collision>

      <inertial>
        <mass value="0.00001"/>
        <origin xyz="0 0 0"/>
        <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
      </inertial>
    </link>

  </xacro:macro>

  <xacro:wheel_link prefix_ns="${frame_ns}" number="0" />
  <xacro:wheel_link prefix_ns="${frame_ns}" number="1" />
  <xacro:wheel_link prefix_ns="${frame_ns}" number="2" />

  <!-- ========== Wheel 0 - Joint ========== -->
  <joint name="${frame_ns}wheel0_joint" type="fixed">   <!--<joint name="wheel0_joint" type="continuous"></joint> -->
    <parent link="${frame_ns}base_link"/>
    <child link="${frame_ns}wheel0_link"/>
    <origin xyz="-0.1825 -0.0001 0.059154" rpy="0 0 ${pi / 2}"/>
    <axis xyz="0 1 0" rpy="0 0 0"/>
  </joint>

  <!-- ========== Wheel 1 - Joint ========== -->
  <joint name="${frame_ns}wheel1_joint" type="fixed">
    <parent link="${frame_ns}base_link"/>
    <child link="${frame_ns}wheel1_link"/>
    <origin xyz="0.090625 -0.157067 0.059154" rpy="0 0 ${(30 * (pi/2)) / 90}"/>
    <axis xyz="0 1 0" rpy="0 0 0"/>
  </joint>

  <!-- ========== Wheel 2 - Joint ========== -->
  <joint name="${frame_ns}wheel2_joint" type="fixed">
    <parent link="${frame_ns}base_link"/>
    <child link="${frame_ns}wheel2_link"/>
    <origin xyz="0.090625 0.156867 0.059154" rpy="0 0 ${-(30 * (pi/2)) / 90}"/>
    <axis xyz="0 1 0" rpy="0 0 0"/>
  </joint>
  <!-- ************************************************************************ -->

  <!-- ****************************** Laser Link ****************************** -->
  <link name="${frame_ns}laser_link">
  </link>

  <joint name="${frame_ns}laser_joint" type="fixed">
    <parent link="${frame_ns}base_link"/>
    <child link="${frame_ns}laser_link"/>
    <origin xyz="0 0 0.14" rpy="0 0 0"/>
  </joint>
  <!-- ************************************************************************ -->

  <!-- ******************** Lower-Right Mounting Bolt ************************* -->
  <!-- Pure TF frame marking the physical mounting bolt on the lower right of -->
  <!-- the robotino chassis. External modules (e.g. the switchlinq_rvr racking -->
  <!-- module) reference this frame to bolt themselves onto the rover. The -->
  <!-- offset matches the historical static_transform_publisher invocation -->
  <!-- with x=0.0622, y=-0.0215, z=0.056, no rotation, -->
  <!-- parent=base_footprint, child=lower_right_mounting_bolt. -->
  <link name="${frame_ns}lower_right_mounting_bolt">
  </link>

  <joint name="${frame_ns}lower_right_mounting_bolt_joint" type="fixed">
    <parent link="${frame_ns}base_footprint"/>
    <child link="${frame_ns}lower_right_mounting_bolt"/>
    <origin xyz="0.0622 -0.0215 0.056" rpy="0 0 0"/>
  </joint>
  <!-- ************************************************************************ -->

  </xacro:macro>

</robot>
