<?xml version="1.0"?>
<!-- Standalone entry point for the Robotino 4 model. -->
<!-- -->
<!-- This file exposes a single prefix xacro arg and instantiates the -->
<!-- robotino4 macro (defined in robotino4.macro.xacro) so it can be used -->
<!-- directly by robot_state_publisher, RViz display launches, and simulation -->
<!-- launches without any further wrapping. -->
<!-- -->
<!-- Composition xacros that need to instantiate the Robotino 4 alongside -->
<!-- other robots with independent prefixes must include robotino4.macro.xacro -->
<!-- and invoke the macro themselves. Never include this file, as its default -->
<!-- macro call would collide with the composition's own instantiations. -->
<robot name="robotino4_barebones_body" xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:arg name="prefix" default=""/>
    <xacro:include filename="$(find rto4_description)/urdf/rover/robotino4.macro.xacro" />

    <xacro:robotino4 prefix="$(arg prefix)" />

</robot>
