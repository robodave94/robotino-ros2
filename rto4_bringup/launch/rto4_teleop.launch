<launch>

  <!-- Namespace must match rto4_bringup (must match rto4_node namespace) -->
  <arg name="ns" default="rto4" description="Namespace matching rto4_bringup (must match rto4_node namespace)"/>


  <node pkg="teleop_twist_keyboard" exec="teleop_twist_keyboard" name="teleop_twist_keyboard" output="screen">
    <remap from="/cmd_vel" to="/$(var ns)/cmd_vel"/>
  </node>

</launch>
